@page "/"
@inject IJSRuntime JS
@inject HttpClient Http
@inject IConfiguration Config

<PageTitle>Kilometrikisa – Firman yhteinen tavoite</PageTitle>

@code {
    record StopConfig(string Name, double Km, double Lat, double Lng);

    StopConfig[] stops = Array.Empty<StopConfig>();
    double tavoiteKm = 4000;

    double ajettu = 0;
    string paivitetty = "";
    bool ladattu = false;
    bool mapInitialized = false;
    bool virhe = false;
    double? edellinenKm = null;

    protected override async Task OnInitializedAsync()
    {
        // Lue config
        tavoiteKm = Config.GetValue<double>("Kilometrikisa:TavoiteKm", 4000);
        stops = Config.GetSection("Kilometrikisa:Stops")
                      .Get<StopConfig[]>() ?? Array.Empty<StopConfig>();

        try
        {
            var data = await Http.GetFromJsonAsync<KilometriData>("data.json");
            if (data != null)
            {
                ajettu = data.KilometritYhteensa;
                edellinenKm = data.EdellinenKm;
                paivitetty = data.Paivitetty ?? "";
            }
        }
        catch
        {
            virhe = true;
        }
        ladattu = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ladattu || mapInitialized) return;
        mapInitialized = true;
        await InitMap();
        StateHasChanged();
    }

    async Task InitMap()
    {
        double loopLength = stops.Length > 0 ? stops[stops.Length - 1].Km : 1;
        double lapKm = ajettu % loopLength;
        double? prevLapKm = edellinenKm.HasValue && edellinenKm.Value < ajettu
            ? edellinenKm.Value % loopLength
            : null;
        // Jos edellinenKm oli eri kierroksella kuin nyt, oranssi alkaa kierroksen alusta
        bool crossedLap = edellinenKm.HasValue &&
            Math.Floor(edellinenKm.Value / loopLength) < Math.Floor(ajettu / loopLength);
        if (crossedLap) prevLapKm = 0;

        var stopsJs = stops.Select(s => new
        {
            name = s.Name,
            km = s.Km,
            lat = s.Lat,
            lng = s.Lng,
            done = lapKm > s.Km,
            next = stops.SkipLast(1).FirstOrDefault(x => x.Km > lapKm)?.Name == s.Name,
        }).ToArray();

        await JS.InvokeVoidAsync("kkMap.init", stopsJs, lapKm,
            prevLapKm.HasValue ? (object)prevLapKm.Value : null);
    }

    record KilometriData(
        double KilometritYhteensa,
        double? EdellinenKm,
        string? Paivitetty,
        string? Haettu,
        string? Lahde);
}

@{
    var fi = new System.Globalization.CultureInfo("fi-FI");
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // Loop-logiikka
    double loopLength = stops.Length > 0 ? stops[stops.Length - 1].Km : 1;
    int kierroksia = loopLength > 0 ? (int)Math.Floor(ajettu / loopLength) : 0;
    double lapKm = ajettu % loopLength;

    // Tavoite (erillinen kokonaisuus)
    double prosentti = tavoiteKm > 0 ? ajettu / tavoiteKm * 100 : 0;
    double jaljella = tavoiteKm - ajettu;
    bool yliTavoitteen = ajettu >= tavoiteKm;
    string pct = Math.Min(prosentti, 100).ToString("F1", inv);

    // Seuraava pysäkki tällä kierroksella (ohita sulkeva pysäkki)
    var lapStops = stops.SkipLast(1).ToArray();
    var seuraava = lapStops.FirstOrDefault(p => p.Km > lapKm);
    double uuttaKm = edellinenKm.HasValue && edellinenKm.Value < ajettu
        ? ajettu - edellinenKm.Value : 0;
}

<div class="kk-page">
    <div class="kk-header">
        <h1 class="kk-title">🚴 Kilometrikisa – Firmatavoite</h1>
        <p class="kk-subtitle">Yhteinen rinkilenkki Suomen halki! · Oulu → Kuopio → Helsinki → Turku → Vaasa → Oulu</p>
    </div>

    @if (!ladattu)
    {
        <div class="kk-loading">Ladataan tietoja…</div>
    }
    else if (virhe)
    {
        <div class="kk-error">⚠️ Tietojen lataus epäonnistui.</div>
    }
    else
    {
        <div id="kk-map"></div>

        <div class="kk-legend">
            <span class="kk-legend-item"><span class="kk-leg-line green"></span> Ajettu (tämä kierros)</span>
            @if (edellinenKm.HasValue && edellinenKm.Value < ajettu)
            {
                <span class="kk-legend-item"><span class="kk-leg-line orange"></span> Uutta edellisestä päivityksestä</span>
            }
            <span class="kk-legend-item"><span class="kk-leg-line grey"></span> Tuleva reitti</span>
        </div>

        <div class="kk-stat-row">
            <div class="kk-stat">
                <span class="kk-stat-label">Kierroksia</span>
                <span class="kk-stat-value kk-green">@kierroksia 🔄</span>
            </div>
            <div class="kk-stat">
                <span class="kk-stat-label">Tällä kierroksella</span>
                <span class="kk-stat-value kk-green">@lapKm.ToString("N1", fi) km</span>
            </div>
            <div class="kk-stat">
                <span class="kk-stat-label">Ajettu yhteensä</span>
                <span class="kk-stat-value">@ajettu.ToString("N1", fi) km</span>
            </div>
            @if (edellinenKm.HasValue && edellinenKm.Value < ajettu)
            {
                <div class="kk-stat">
                    <span class="kk-stat-label">Uutta edellisestä päivityksestä</span>
                    <span class="kk-stat-value kk-orange">+@uuttaKm.ToString("N1", fi) km 🔥</span>
                </div>
            }
        </div>

        @* Kokonaistavoite erillään rinkkireiteistä *@
        @if (tavoiteKm > 0)
        {
            <div class="kk-progress-wrap">
                <div class="kk-progress-bar" style="width: @pct%">
                    <span class="kk-progress-label">@pct% tavoitteesta</span>
                </div>
            </div>
            @if (yliTavoitteen)
            {
                <p class="kk-next kk-win">🏆 Km-tavoite @tavoiteKm.ToString("N0", fi) km saavutettu! Mahtavaa pyöräilyä!</p>
            }
        }

        @if (seuraava != null)
        {
            double kmSeuraavaan = seuraava.Km - lapKm;
            <p class="kk-next">
                Seuraava pysäkki: <strong>@seuraava.Name</strong> –
                enää <strong>@kmSeuraavaan.ToString("N1", fi) km</strong> jäljellä! 💪
            </p>
        }

        @if (!string.IsNullOrEmpty(paivitetty))
        {
            <p class="kk-updated">Kilometrikisa.fi päivitetty: @paivitetty</p>
        }

        <div class="kk-stops">
            @foreach (var p in lapStops)
            {
                bool ohitettu = lapKm >= p.Km;
                bool seuraavaPys = seuraava?.Name == p.Name;
                <div class="kk-stop @(ohitettu ? "done" : "") @(seuraavaPys ? "next" : "")">
                    <span class="kk-stop-icon">@(ohitettu ? "✅" : seuraavaPys ? "🎯" : "⭕")</span>
                    <span class="kk-stop-name">@p.Name</span>
                    <span class="kk-stop-km">@p.Km km</span>
                    @if (ohitettu)
                    {
                        <span class="kk-stop-badge">Ohitettu!</span>
                    }
                </div>
            }
        </div>
    }
</div>
